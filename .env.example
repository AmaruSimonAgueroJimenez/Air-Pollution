# ============================================================
# Credenciales para el pipeline de descarga (scripts_pipeline/).
# Copia este archivo a .env y complétalo. .env está en .gitignore.
# ============================================================

# --- NASA Earthdata --------------------------------------------------
# Requerido para: Sentinel-5P TROPOMI (GES DISC), MODIS MAIAC/AOD,
# MERRA-2 (M2TMNXAER, meteo), MOPITT (CO), OMI (NO2/O3/SO2), NASADEM.
# Regístrate: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Alternativa por token (bearer) para APIs que lo aceptan.
# OJO: dejarla vacía (EARTHDATA_TOKEN=) rompe earthaccess: manda "Bearer ''"
# y CMR devuelve 401 "Token does not exist". Descoméntala solo con token real.
# EARTHDATA_TOKEN=

# --- Copernicus CDS (Climate Data Store) -----------------------------
# Requerido para: ERA5, ERA5-Land.
# Regístrate y copia tu key: https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Copernicus ADS (Atmosphere Data Store) --------------------------
# Requerido para: CAMS reanálisis global EAC4 (NO2, O3, SO2, CO, PM2.5, PM10).
# Regístrate y copia tu key: https://ads.atmosphere.copernicus.eu/
ADSAPI_URL=https://ads.atmosphere.copernicus.eu/api
ADSAPI_KEY=

# --- NASA GEOS-CF (opcional) -----------------------------------------
# Composición atmosférica GEOS-CF (OPeNDAP público; normalmente sin credencial).
GEOSCF_OPENDAP_BASE=https://opendap.nccs.nasa.gov/dods/gmao/geos-cf

# --- SINCA (verdad-terreno, sin credencial) --------------------------
# Sistema de Información Nacional de Calidad del Aire (https://sinca.mma.gob.cl/)
# Descarga pública; no requiere credenciales.
